{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ES2020",
    "moduleResolution": "bundler",
    
    /* Emit */
    "sourceMap": true,
    "outDir": "./",
    "rootDir": "./",
    
    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    
    /* Type Checking */
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    
    /* Completeness */
    //"skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}